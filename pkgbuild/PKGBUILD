pkgname=hotbox
pkgver=0.2.0
pkgrel=1
pkgdesc='Persistent workspace chats and a pointer-centered desktop hotbox'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt' 'xdg-desktop-portal' 'git')
makedepends=('gcc' 'make')
source=()
sha256sums=()
build() { cd "$startdir/.."; ./bin/build; }
package() {
 cd "$startdir/.."
 install -Dm755 build/hotbox "$pkgdir/usr/bin/hotbox"
 install -Dm644 LICENSE "$pkgdir/usr/share/licenses/hotbox/LICENSE"
 install -Dm644 pkgbuild/hotbox.desktop "$pkgdir/usr/share/applications/hotbox.desktop"
 install -Dm644 pkgbuild/hotbox.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/hotbox.svg"
 install -Dm644 integration/hotbox.lua "$pkgdir/usr/share/hotbox/hotbox.lua"
}
