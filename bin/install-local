#!/usr/bin/env python3
"""Build and install the GUI and core helper together into the user's bin directory."""
import os
import datetime
import sqlite3
from contextlib import closing
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

root=Path(__file__).resolve().parent.parent
if sys.argv[1:] not in ([], ['--desktop-only']):
    raise SystemExit('Usage: bin/install-local [--desktop-only]')
subprocess.run([str(root/'bin/build'),*sys.argv[1:]],check=True)
home=Path.home()
destination=home/'.local/bin'
destination.mkdir(parents=True,exist_ok=True)
data=Path(os.environ.get('XDG_DATA_HOME',home/'.local/share'))/'hotbox'
backups=data/'backups'
backups.mkdir(parents=True,exist_ok=True)
backups.chmod(0o700)
stamp=datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
# SQLite's backup API includes committed WAL data, unlike copying a live DB file.
for name in ('hotbox.sqlite3','orchestration.sqlite3'):
    database=data/name
    if database.exists():
        backup=backups/('before-update-'+stamp+'-'+name)
        with closing(sqlite3.connect(database.as_uri()+'?mode=ro',uri=True)) as source:
            with closing(sqlite3.connect(backup)) as target:
                source.backup(target)
        backup.chmod(0o600)
for name in ('hotbox','hotbox-core'):
    previous=destination/name
    if previous.exists():
        shutil.copy2(previous,backups/(name+'-'+stamp))
files=[(root/'build/hotbox-core',destination/'hotbox-core'),
       (root/'build/hotbox',destination/'hotbox'),
       (root/'pkgbuild/hotbox.desktop',Path(os.environ.get('XDG_DATA_HOME',home/'.local/share'))/'applications/hotbox.desktop'),
       (root/'pkgbuild/hotbox.svg',Path(os.environ.get('XDG_DATA_HOME',home/'.local/share'))/'icons/hicolor/scalable/apps/hotbox.svg')]
staged=[]
ollama = root/'.tools/ollama/bin/ollama'
if ollama.is_file():
    files.append((ollama, home/'.local/lib/hotbox/ollama'))
libraries = root/'.tools/ollama/lib/ollama'
if libraries.is_dir():
    library_target = home/'.local/lib/hotbox/lib/ollama'
    library_target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=library_target.parent, prefix='ollama-install-') as temporary:
        replacement = Path(temporary)/'new'
        previous = Path(temporary)/'previous'
        shutil.copytree(libraries, replacement, symlinks=True)
        if library_target.exists():
            os.replace(library_target, previous)
        try:
            os.replace(replacement, library_target)
        except OSError:
            if previous.exists():
                os.replace(previous, library_target)
            raise
try:
    for source,target in files:
        target.parent.mkdir(parents=True,exist_ok=True)
        with tempfile.NamedTemporaryFile(dir=target.parent,prefix=target.name+'.new-',delete=False) as file:
            temporary=Path(file.name)
        staged.append((temporary,target))
        shutil.copy2(source,temporary)
        temporary.chmod(0o755 if target.parent==destination or target.name=='ollama' else 0o644)
    for temporary,target in staged:
        os.replace(temporary,target)
finally:
    for temporary,_ in staged:
        temporary.unlink(missing_ok=True)
print('Backed up private state and previous binaries; installed GUI, core and launcher. Running processes are unchanged.')
