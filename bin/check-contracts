#!/usr/bin/env python3
"""Validate the canonical build API and check its generated reference/runtime catalog."""
import argparse
import hashlib
import json
from pathlib import Path
import re
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
SOURCE = Path('src/build-ledger-api-v1.json')
REFERENCE = Path('core/docs/BUILD_LEDGER_REFERENCE.md')


def validate(root):
    raw = (root / SOURCE).read_bytes()
    data = json.loads(raw)
    if data['schema_version'] != 1 or data['api'] != 'hotbox.build':
        raise ValueError('Unsupported build API contract')
    for key in ('integer_fields', 'node_kinds', 'planning_states', 'link_kinds'):
        values = data[key]
        if not values or len(values) != len(set(values)) or not all(isinstance(v, str) for v in values):
            raise ValueError('Invalid or duplicate values: ' + key)
    for name, operation in data['operations'].items():
        if not re.fullmatch(r'[a-z]+(?:\.[a-z]+)?', name):
            raise ValueError('Invalid operation name: ' + name)
        if operation['mode'] not in ('read', 'mutation'):
            raise ValueError('Invalid operation mode: ' + name)
        fields, required = operation['fields'], operation['required']
        if len(fields) != len(set(fields)) or not set(required) <= set(fields):
            raise ValueError('Invalid fields/required fields: ' + name)
        if not all(re.fullmatch(r'[a-z_]+', field) for field in fields):
            raise ValueError('Invalid field name: ' + name)
        if operation['mode'] == 'mutation' and 'request_id' not in required:
            raise ValueError('Mutation lacks request identity: ' + name)
        if operation['mode'] == 'mutation' and name != 'create' and not {'roadmap', 'expected_revision'} <= set(required):
            raise ValueError('Mutation lacks roadmap revision: ' + name)
    for group in ('implementation', 'verification'):
        for ref in data[group]:
            path = (root / ref['path']).resolve()
            if not path.is_relative_to(root.resolve()) or not path.is_file():
                raise ValueError('Missing/outside-repository reference: ' + ref['path'])
            if ref['symbol'] not in path.read_text():
                raise ValueError('Missing symbol: ' + ref['path'] + ': ' + ref['symbol'])
    return data, hashlib.sha256(raw).hexdigest()


def render(data, digest):
    lines = [
        '# Build ledger API reference (generated)', '',
        'Generated by `bin/check-contracts --write`; edit the [source contract](../../src/build-ledger-api-v1.json), then regenerate.', '',
        f"Contract: `{data['contract_id']}`. API version: **{data['schema_version']}**. Storage version: **{data['storage_version']}**.", '',
        f'Source SHA-256: `{digest}`.', '',
        'The app uses this catalog for accepted fields, required fields, enums and read/mutation classification. SQL, scope, conditional requirements and execution semantics remain implemented in the linked code and explained in the [behavior guide](BUILD_LEDGER_API.md).', '',
        'Every request also requires numeric `schema_version: 1`. Fields below are in addition to it. Optional fields may have conditional requirements explained in the behavior column.', '',
        '| Operation | Mode | Required fields | Optional fields | Behavior |',
        '| --- | --- | --- | --- | --- |',
    ]
    def names(values):
        return ', '.join('`' + value + '`' for value in values) or 'None'
    for name, operation in sorted(data['operations'].items()):
        optional = [f for f in operation['fields'] if f not in operation['required']]
        lines.append(f"| `{name}` | {operation['mode']} | {names(operation['required'])} | {names(optional)} | {operation['summary'].replace('|', chr(92) + '|')} |")
    lines += ['', 'Integer fields: ' + names(data['integer_fields']) + '. All other request fields are text.', '']
    for label, key in [('Node kinds', 'node_kinds'), ('Planning states', 'planning_states'), ('Link kinds', 'link_kinds')]:
        lines += [label + ': ' + names(data[key]) + '.', '']
    for title, group in [('Implementation references', 'implementation'), ('Verification references', 'verification')]:
        lines += ['## ' + title, '']
        for ref in data[group]:
            lines.append(f"- [{ref['path']}](../../{ref['path']}): `{ref['symbol']}`.")
        lines.append('')
    lines += [
        '## Verification boundary', '',
        '`bin/check-contracts --binary build/hotbox` compares this reference and the compiled runtime catalog with the source contract using a temporary database. It also checks that linked files/symbols exist. It does not prove the behavior behind each symbol; run `bin/test --desktop-only --offline` and `bin/test-cli` for the executable checks. Offline testing excludes three TCP mocks and reuses the existing Rust helper.', '',
        'No generated reference or planning state grants dispatch authority or confirms functionality. General Rust runner/verifier integration remains planned.', '',
    ]
    return '\n'.join(lines)


def check_runtime(binary, data):
    with tempfile.TemporaryDirectory(prefix='hotbox-contract-check-') as tmp:
        directory = Path(tmp)
        request = directory / 'request.json'
        request.write_text('{"schema_version":1}')
        result = subprocess.run([str(binary.resolve()), 'build', 'schema', '--data-dir', str(directory / 'data'), '--request-file', str(request)], text=True, capture_output=True, timeout=20)
        if result.returncode:
            raise ValueError('Runtime schema lookup failed: ' + (result.stderr or result.stdout)[:500])
        runtime = json.loads(result.stdout)
        for key in ('api', 'schema_version', 'contract_id', 'storage_version', 'semantics', 'node_kinds', 'planning_states', 'link_kinds'):
            if runtime.get(key) != data[key]:
                raise ValueError('Compiled catalog differs: ' + key + '; rebuild the app')
        if runtime.get('operation_contracts') != data['operations']:
            raise ValueError('Compiled operation contracts differ; rebuild the app')
        expected = {name: op['fields'] for name, op in data['operations'].items()}
        if runtime.get('operations') != expected:
            raise ValueError('Compatibility field catalog differs')
        readers = sorted(name for name, op in data['operations'].items() if op['mode'] == 'read')
        if runtime.get('read_operations') != readers:
            raise ValueError('Compiled read classification differs')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--write', action='store_true', help='Regenerate the source-controlled API reference')
    parser.add_argument('--binary', type=Path, help='Also compare a compiled Hotbox catalog in temporary storage')
    args = parser.parse_args()
    data, digest = validate(ROOT)
    generated = render(data, digest)
    if args.write:
        (ROOT / REFERENCE).write_text(generated)
    if not (ROOT / REFERENCE).is_file() or (ROOT / REFERENCE).read_text() != generated:
        raise ValueError('Generated reference is stale; run bin/check-contracts --write')
    if args.binary:
        check_runtime(args.binary, data)
    print('Build API contract passed: reference, source symbols' + (', compiled catalog' if args.binary else '') + '.')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, KeyError, OSError, subprocess.SubprocessError) as error:
        raise SystemExit(str(error))
