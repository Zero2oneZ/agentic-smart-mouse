#!/usr/bin/env python3
"""Run Cargo with project-local compiler tools and dependency cache when available."""
import os
from pathlib import Path
import shutil
import sys

root = Path(__file__).resolve().parent.parent
rust_bin = root / '.tools/rust/bin'
local_cargo = rust_bin / 'cargo'
cargo = str(local_cargo) if local_cargo.is_file() else shutil.which('cargo')
if not cargo:
    raise SystemExit('Rust/Cargo is unavailable. Install a Rust toolchain, or place it under .tools/rust.')
env = os.environ.copy()
env.setdefault('CARGO_HOME', str(root / '.tools/cargo'))
if local_cargo.is_file():
    env['PATH'] = str(rust_bin) + os.pathsep + env.get('PATH', '')
    env.setdefault('RUSTC', str(rust_bin / 'rustc'))
    env.setdefault('RUSTDOC', str(rust_bin / 'rustdoc'))
os.execve(cargo, [cargo, *sys.argv[1:]], env)
