{
  "schema_version": 1,
  "id": "quarantine-backpack",
  "version": "1.0.0",
  "architecture_ref": "system-catalog-v1",
  "harness_ref": "quarantine-harness-v1",
  "agent_ref": null,
  "zone": "quarantine",
  "abilities": [
    "read_artifact",
    "parse_document",
    "validate_schema",
    "transform_data",
    "write_artifact"
  ],
  "artifacts": {
